# --- Database (Neon Postgres) ---
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-shiny-silence-aj2lu1lv-pooler.c-3.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- LLM (OpenRouter, OpenAI-compatible) ---
OPENROUTER_API_KEY=sk-or-v1-...
# Default model + short-list surfaced in developer settings
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_MODELS=anthropic/claude-sonnet-4.5,anthropic/claude-haiku-4.5,openai/gpt-4o-mini,google/gemini-2.0-flash

# --- Web search ---
TAVILY_API_KEY=tvly-...

# --- Publishing ---
BUFFER_ACCESS_TOKEN=1/...
BUFFER_PROFILE_IG=              # Buffer profile/channel id for Instagram
BUFFER_PROFILE_LI=              # Buffer profile/channel id for LinkedIn

RESEND_API_KEY=re_...
RESEND_FROM=Signal <noreply@yourdomain.com>
RESEND_TEST_TO=you@example.com  # where the newsletter goes for demo

# --- Observability (LangSmith) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=signal-content-agent
# EU workspaces: https://eu.api.smith.langchain.com
# US workspaces (default): https://api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Runtime ---
PUBLISH_MODE=preview            # preview | real  — preview mocks Buffer/Resend calls
LEARNING_MIN_SAMPLES=5          # min reason-code occurrences to propose a rule (§6.2)
LEARNING_WINDOW=8               # rolling window for pattern detection
CRAWL_MAX_PAGES=6
CRAWL_TIMEOUT_S=15
CYCLE_CANDIDATE_TARGET=10
COMPANY_ID=demo                 # single-tenant sprint: one company per instance

# --- App ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
